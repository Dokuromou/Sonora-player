{
  "id": "./",
  "name": "Sonora — Personal Local Music Player",
  "short_name": "Sonora",
  "description": "Offline-first personal local music player with 10-band equalizer, album art & tag parser, synced lyrics, playlists, and Android background controls.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090A10",
  "theme_color": "#090A10",
  "categories": ["music", "entertainment", "utilities"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Music Library",
      "short_name": "Library",
      "url": "./#library",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "url": "./#playlists",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Equalizer",
      "short_name": "Equalizer",
      "url": "./#equalizer",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
